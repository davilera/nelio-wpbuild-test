{
	"name": "nelio",
	"version": "1.0.0",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"wpPlugin": {
		"name": "nelio",
		"scriptGlobal": "nelio",
		"packageNamespace": "nelio",
		"handlePrefix": "nelio",
		"pages": [
			"nelio-dashboard"
		]
	},
	"scripts": {
		"build": "wp-build",
		"build:clean": "rm -rf build packages/**/build; echo 'Clean!'",
		"cleanall": "yarn run build:clean; rm -rf node_modules package.lock",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@wordpress/babel-preset-default": "^8.44.0",
		"@wordpress/build": "^0.12.0",
		"@wordpress/components": "^32.6.0"
	}
}
