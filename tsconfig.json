{
	"buildOnSave": false,
	"compileOnSave": false,
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"allowUnusedLabels": false,
		"alwaysStrict": true,
		"checkJs": true,
		"declaration": true,
		"declarationMap": true,
		"emitDeclarationOnly": true,
		"emitDecoratorMetadata": true,
		"esModuleInterop": true,
		"exactOptionalPropertyTypes": false,
		"experimentalDecorators": true,
		"isolatedModules": true,
		"jsx": "preserve",
		"lib": [ "DOM", "DOM.Iterable", "ESNext" ],
		"module": "preserve",
		"moduleResolution": "bundler",
		"noFallthroughCasesInSwitch": true,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noImplicitThis": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"pretty": true,
		"removeComments": false,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"target": "esnext",
		"allowJs": true,
		"paths": {
			"@nelio/components": [ "./packages/components/src/index.ts" ],
			"@nelio/utils": [ "./packages/utils/src/index.ts" ]
		}
	},
	"include": [ "./packages", "./routes" ],
	"exclude": [
		"./node_modules",
		"./build",
		"./**/build",
		"./**/build-module"
	]
}
